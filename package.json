{
  "name": "@wyattjoh/pi-bridge",
  "version": "0.1.0",
  "description": "Opt-in Pi extension for Claude Code peer messaging over a Unix socket",
  "keywords": [
    "claude-code",
    "peer-messaging",
    "pi-extension",
    "pi-package"
  ],
  "homepage": "https://github.com/wyattjoh/pi-bridge#readme",
  "bugs": {
    "url": "https://github.com/wyattjoh/pi-bridge/issues"
  },
  "license": "MIT",
  "author": "Wyatt Johnson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyattjoh/pi-bridge.git"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "check": "bun run typecheck && bun run format:check && bun run lint && bun test",
    "prepublishOnly": "bun run check"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@types/bun": "1.3.14",
    "@types/node": "24.12.4",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "packageManager": "bun@1.3.14",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
